@{
    ViewBag.Title = "About";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>
    <h3>@ViewBag.Message</h3>

    <p>Use this area to provide additional information.</p>
</main>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Dashboard</title>

    <style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    display: flex;
    background-color: #f4f6f9;
}

/* Sidebar */
.sidebar {
    width: 220px;
    height: 100vh;
    background: #2c3e50;
    color: white;
    padding: 20px;
    position: fixed;
}

.sidebar h2 {
    margin-bottom: 30px;
    text-align: center;
}

.sidebar ul {
    list-style: none;
}

.sidebar ul li {
    padding: 12px;
    margin: 10px 0;
    cursor: pointer;
    border-radius: 5px;
}

.sidebar ul li:hover {
    background: #34495e;
}

/* Main Content */
.main {
    margin-left: 220px;
    width: 100%;
    padding: 20px;
}

/* Navbar */
.navbar {
    background: white;
    padding: 15px 20px;
    margin-bottom: 20px;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* Cards */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.card h3 {
    margin-bottom: 10px;
    color: #555;
}

.card p {
    font-size: 24px;
    font-weight: bold;
}

/* Table */
.table-container {
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

table {
    width: 100%;
    border-collapse: collapse;
}

table th, table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

table th {
    background-color: #f8f9fa;
}

    </style>
</head>

<body>

    <div class="sidebar">
        <h2>My Dashboard</h2>
        <ul>
            <li>Home</li>
            <li>Analytics</li>
            <li>Users</li>
            <li>Reports</li>
            <li>Settings</li>
        </ul>
    </div>

    <div class="main">
        <div class="navbar">
            <div>Dashboard Overview</div>
            <div>Welcome, Admin</div>
        </div>

        <div class="cards">
            <div class="card">
                <h3>Total Users</h3>
                <p>1,245</p>
            </div>
            <div class="card">
                <h3>Revenue</h3>
                <p>$8,430</p>
            </div>
            <div class="card">
                <h3>Orders</h3>
                <p>320</p>
            </div>
            <div class="card">
                <h3>Pending</h3>
                <p>18</p>
            </div>
        </div>

        <div class="table-container">
            <h3>Recent Orders</h3>
            <br>
            <table>
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#1024</td>
                        <td>John Doe</td>
                        <td>Completed</td>
                        <td>$250</td>
                    </tr>
                    <tr>
                        <td>#1025</td>
                        <td>Jane Smith</td>
                        <td>Pending</td>
                        <td>$180</td>
                    </tr>
                    <tr>
                        <td>#1026</td>
                        <td>Mike Johnson</td>
                        <td>Cancelled</td>
                        <td>$90</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

</body>
</html>